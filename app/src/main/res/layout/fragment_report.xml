<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp">   <!-- 👈 Ensures button not hidden by bottom nav -->

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Photo Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload / Capture Photo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_placeholder"
                android:background="@drawable/card_background"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capture Photo"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_background"/>

            <!-- Location Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Location"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <org.osmdroid.views.MapView
                android:id="@+id/mapReport"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/card_background"
                android:elevation="4dp"/>

            <!-- Category -->
            <EditText
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category (Plastic, Wet, etc.)"
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="10dp"
                android:layout_marginTop="16dp"/>

            <!-- Notes -->
            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes (Optional)"
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="10dp"
                android:layout_marginTop="12dp"/>

            <!-- Submit Button (placed right after Notes) -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Report"
                android:textColor="#FFFFFF"
                android:layout_marginTop="20dp"
                android:background="#FF0000"/>  <!-- 🔴 Red for testing -->

            <!-- ProgressBar (below button) -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
