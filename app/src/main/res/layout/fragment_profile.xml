<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:elevation="6dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="15sp"
                android:textColor="#7F8C8D"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points: 0"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#27AE60"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Personal Info Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp">

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:inputType="phone"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Address"
                android:inputType="textPostalAddress"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Age"
                android:inputType="number"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gender"
                android:inputType="text"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSaveInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Info"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:background="@drawable/button_background" />
        </LinearLayout>

        <!-- Training Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnTraining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Training"
                android:textAllCaps="false"
                android:background="@drawable/button_background"
                android:textColor="#FFF" />

            <TextView
                android:id="@+id/statusTraining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Pending"
                android:textSize="14sp"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Distribution Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnDistribution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Distribution"
                android:textAllCaps="false"
                android:background="@drawable/button_background"
                android:textColor="#FFF" />

            <TextView
                android:id="@+id/statusDistribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Pending"
                android:textSize="14sp"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Events Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnEvents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Community Events"
                android:textAllCaps="false"
                android:background="@drawable/button_background"
                android:textColor="#FFF" />

            <TextView
                android:id="@+id/statusEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Pending"
                android:textSize="14sp"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"
            android:background="@drawable/button_background" />

        <EditText
            android:id="@+id/sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="---------"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
