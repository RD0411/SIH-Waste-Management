<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light gray background -->
    <solid android:color="#ECEFF1"/>

    <!-- Rounded corners -->
    <corners android:radius="12dp"/>

    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#B0BEC5"/>

    <!-- Padding inside placeholder -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
